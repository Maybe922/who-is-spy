# Supabase PostgreSQL transaction pooler.
# Replace <URL_ENCODED_DATABASE_PASSWORD> with your database password after URL encoding.
# Example: "@" must be written as "%40".
DATABASE_URL="postgresql://postgres.jioihmhmvvplfvdttfjv:<URL_ENCODED_DATABASE_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations/schema push should use Supabase Session pooler or direct connection.
# In Supabase "Connect" panel, choose "Session pooler" and copy its URI.
DIRECT_URL="postgresql://postgres.jioihmhmvvplfvdttfjv:<URL_ENCODED_DATABASE_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Used later for login session signing. Generate a long random value before enabling auth.
SESSION_SECRET="replace-with-a-long-random-string"
